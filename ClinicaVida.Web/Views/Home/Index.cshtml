@{
    ViewData["Title"] = "Clínica Vida+";
}

<section id="apresentacao">

    <h1>Clínica Vida+</h1>

    <p>
        A Clínica Vida+ oferece atendimento médico de qualidade
        e facilita o <strong>agendamento de consultas</strong>
        para seus pacientes.
    </p>

    <p>
        Nosso objetivo é tornar o atendimento mais simples,
        rápido e acessível.
    </p>

    <p>
        Contamos com profissionais qualificados e diferentes
        especialidades para atender às necessidades dos pacientes.
    </p>

</section>

<section id="especialidades">

    <h2>Especialidades</h2>

    <p>
        Conheça algumas das especialidades disponíveis
        na Clínica Vida+.
    </p>

    <label for="busca-especialidade">
        Buscar especialidade
    </label>

    <input
        type="search"
        id="busca-especialidade"
        placeholder="Digite uma especialidade">

    <ul class="lista-especialidades">

        <li>
            <strong>Cardiologia</strong>
            <p>Atendimento relacionado à saúde do coração e do sistema cardiovascular.</p>
        </li>

        <li>
            <strong>Pediatria</strong>
            <p>Atendimento médico voltado para crianças e adolescentes.</p>
        </li>

        <li>
            <strong>Dermatologia</strong>
            <p>Cuidados e tratamentos relacionados à pele, cabelos e unhas.</p>
        </li>

        <li>
            <strong>Ortopedia</strong>
            <p>Atendimento relacionado aos ossos, músculos e articulações.</p>
        </li>

        <li>
            <strong>Ginecologia</strong>
            <p>Atendimento voltado à saúde da mulher.</p>
        </li>

        <li>
            <strong>Clínica Geral</strong>
            <p>Atendimento médico geral e acompanhamento da saúde do paciente.</p>
        </li>

    </ul>

</section>

<section id="corpo-clinico">

    <h2>Corpo clínico</h2>

    <p>
        Conheça alguns dos profissionais que fazem parte
        da equipe da Clínica Vida+.
    </p>

    <table>

        <caption>
            Médicos da Clínica Vida+
        </caption>

        <thead>

            <tr>
                <th scope="col">Nome</th>
                <th scope="col">CRM</th>
                <th scope="col">Especialidade</th>
            </tr>

        </thead>

        <tbody>

            <tr>
                <td>Ana Prado</td>
                <td>CRM-SP 112233</td>
                <td>Cardiologia</td>
            </tr>

            <tr>
                <td>Bruno Lima</td>
                <td>CRM-SP 445566</td>
                <td>Pediatria</td>
            </tr>

            <tr>
                <td>Carla Reis</td>
                <td>CRM-SP 778899</td>
                <td>Dermatologia</td>
            </tr>

        </tbody>

    </table>

</section>

<section id="agendamento">

    <h2>Agende sua consulta</h2>

    <p>
        Escolha a especialidade e o profissional de sua preferência
        e faça seu agendamento de forma rápida e simples.
    </p>

    <p>
        <a href="/agendamento.html">
            Agendar consulta
        </a>
    </p>

</section>